# Existing application integrations
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL="SodaSplash <billing@sodasplash.me>"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPPORT_EMAIL=support@sodasplash.me
NEXT_PUBLIC_SUPPORT_PHONE=
ADMIN_API_KEY=

# Browser API base. This includes /api because client-side requests append
# service paths such as /auth/login and /products.
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8080/api

# Server-side gateway origin. This must not include /api because Next.js route
# handlers and server-rendered pages append /api themselves.
GATEWAY_URL=http://localhost:8080

# Keep all client-side service requests routed through the gateway.
NEXT_PUBLIC_AUTH_SERVICE_URL=http://localhost:8080/api
NEXT_PUBLIC_PRODUCT_SERVICE_URL=http://localhost:8080/api
NEXT_PUBLIC_ORDER_SERVICE_URL=http://localhost:8080/api

# Server-side Next.js API routes use the gateway origin.
AUTH_SERVICE_URL=http://localhost:8080
PRODUCT_SERVICE_URL=http://localhost:8080
ORDER_SERVICE_URL=http://localhost:8080
